index 914430f..b265197 100644
--- a/shared/common.sh
+++ b/shared/common.sh
@@ -12,6 +12,24 @@ function extract {
 	fi
 }
 
+function verify_download {
+	archive=$1
+	name=$2
+
+	case "$name" in
+		*.tar.gz|*.tgz) gzip -t -- "$archive" ;;
+		*.tar.bz2) bzip2 -t -- "$archive" ;;
+		*.tar.xz) xz -t -- "$archive" ;;
+		*.zip) unzip -tqq "$archive" >/dev/null ;;
+		*) test -s "$archive" ;;
+	esac
+}
+
+function download_archive {
+	source_url=$1
+	target=$2
+	shift 2
+	curl --fail --silent --show-error --location --retry 5 --retry-delay 1 \
+		--retry-all-errors "$@" --output "$target" "$source_url"
+}
+
